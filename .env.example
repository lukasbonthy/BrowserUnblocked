# Render provides PORT automatically.
PORT=10000

# Strongly recommended for public deployments.
# Users must enter this before the noVNC password is exposed to the browser page.
PORTAL_PASSWORD=change-me

# Optional. If not set, bin/start.sh generates a random VNC password per boot.
VNC_PASSWORD=change-this-too

# Browser/display tuning.
DISPLAY=:99
RESOLUTION=1440x900x24
CHROME_HOME=https://www.google.com

# Internal ports. Usually do not change.
VNC_PORT=5900
NOVNC_PORT=6080
